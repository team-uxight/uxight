# 호스트 직접 실행 시: 이 파일을 .env 로 복사해 채운다 — 앱(pydantic-settings)이 실행 위치(services/agent)의 .env 를 읽는다.
# Docker 에서는 .env 가 이미지에 들어가지 않는다(.dockerignore) — compose 가 환경변수로 주입한다.
# LLM — 엘리스 MLAPI (OpenAI 호환). 주소 · 키는 PM 이 DM 으로 준다 (회사 주소라 저장소엔 안 올린다)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=openai/gpt-5.6-luna
# MySQL — api 와 같은 DB. agent 는 runs.status · run_personas · run_metrics 에 쓴다
DB_URL=mysql+pymysql://uxight:@localhost:3306/uxight
# step 로그 루트 — <LOG_DIR>/<run_id>/<persona_id>/steps.jsonl
LOG_DIR=data/runs
