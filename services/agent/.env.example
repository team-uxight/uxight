# compose 전용 참고용 — 앱이 이 파일을 직접 읽지 않는다 (dotenv 없음).
# 값은 루트 .env 를 채우면 compose 가 컨테이너에 주입한다. 단독 실행 시엔 셸 환경변수로 준다.
# LLM — 엘리스 MLAPI (OpenAI 호환). 주소 · 키는 PM 이 DM 으로 준다 (회사 주소라 저장소엔 안 올린다)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=openai/gpt-5.6-luna
# MySQL — api 와 같은 DB. agent 는 runs.status · 로그 테이블에 쓴다
DB_URL=mysql+pymysql://uxight:@localhost:3306/uxight
