# compose 용. `cp .env.example .env` 로 복사한 뒤 빈 칸(비밀번호 · 키)만 채운다 — .env 는 커밋되지 않는다 (docs/secrets.md)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=uxight
MYSQL_USER=uxight
MYSQL_PASSWORD=
# api access 토큰(JWT, HS256) 서명 키. 32바이트 이상 — `openssl rand -base64 32` 로 만든다. 비우면 api 가 기동마다 임의 키를 쓴다(재기동 시 로그인 풀림)
JWT_SECRET=
# LLM — 엘리스 MLAPI (OpenAI 호환). 모델은 그대로 두고, 주소 · 키는 PM 이 DM 으로 준 LLM 가이드를 보고 채운다 (1인 1키, 회사 주소라 저장소엔 안 올린다)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=openai/gpt-5.6-luna
