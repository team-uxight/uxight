# API 서버 주소 (브라우저가 부르는 값). 로컬 compose 기준
VITE_API_BASE_URL=http://localhost:8080
# Google Cloud 의 OAuth 클라이언트 ID. 백엔드의 GOOGLE_CLIENT_ID 와 같은 값을 쓴다.
VITE_GOOGLE_CLIENT_ID=

# --- 로컬 화면을 dev 서버(https://dev.uxight.duckdns.org) API 에 붙일 때 ---
# 1) 위 VITE_API_BASE_URL 을 빈 값으로 둔다:  VITE_API_BASE_URL=
# 2) 아래 둘을 채운다. 팀 잠금 쿠키 값은 PM 에게 DM 으로 받는다(커밋하지 않는다).
#    브라우저는 localhost 로만 부르고, npm run dev 가 /api 를 dev 서버로 넘긴다.
DEV_PROXY_TARGET=
DEV_TEAM_COOKIE=
